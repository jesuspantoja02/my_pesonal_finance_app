rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Admin por custom claim O por Gmail (plan Spark, sin Cloud Functions).
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        request.auth.token.email == 'jesuspantojabarrial.02@gmail.com'
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    match /app_users/{userId} {
      allow read: if isOwner(userId) || isAdmin();

      allow create, update: if isOwner(userId)
        && request.resource.data.keys().hasOnly([
          'email',
          'displayName',
          'authProvider',
          'lastLoginAt',
          'createdAt',
          'photoUrl',
          'platform',
          'appVersion',
          'loginCount'
        ])
        && request.resource.data.email is string
        && request.resource.data.displayName is string
        && request.resource.data.authProvider is string;

      allow delete: if false;

      match /login_events/{eventId} {
        allow read: if isAdmin();

        allow create: if isOwner(userId)
          && request.resource.data.keys().hasOnly([
            'at',
            'platform',
            'appVersion',
            'authProvider'
          ])
          && request.resource.data.at is timestamp
          && request.resource.data.platform is string
          && request.resource.data.appVersion is string
          && request.resource.data.authProvider is string;

        allow update, delete: if false;
      }
    }
  }
}
